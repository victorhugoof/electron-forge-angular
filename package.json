{
  "name": "electron-forge-angular",
  "version": "1.0.0",
  "scripts": {
    "preinstall": "git config --local core.hooksPath .githooks && git config --local core.autocrlf input",
    "postinstall": "npm run install-deps:angular && npm run install-deps:electron",
    "install-deps:angular": "cd angular-app && npm install",
    "install-deps:electron": "cd electron-app && npm install",
    "start": "concurrently -k \"npm:start:angular\" \"npm:start:electron\"",
    "start:angular": "cd angular-app && npm start",
    "start:electron": "cd electron-app && npm start",
    "package": "npm run package:angular && npm run package:electron",
    "package:angular": "cd angular-app && npm run build",
    "package:electron": "cd electron-app && npm run package",
    "build": "npm run build:angular && npm run build:electron",
    "build:angular": "cd angular-app && npm run build",
    "build:electron": "cd electron-app && npm run build",
    "lint": "eslint . && prettier . --check --ignore-unknown",
    "lint:fix": "eslint . --fix && prettier . --write --ignore-unknown"
  },
  "keywords": [],
  "author": {
    "name": "Victor Fernandes",
    "email": "victor.fernandes@triersistemas.com.br"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
